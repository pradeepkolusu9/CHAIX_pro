# LawLink — environment configuration
#
# The app runs with ZERO configuration on localStorage. This is deliberate:
# a live demo must never fail because of a network or auth error.
#
# Add the two values below to switch persistence to Supabase. No code change
# and no feature work is required — the storage layer detects them at runtime.

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / public key (safe to ship in a client bundle)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: the public URL where the app is deployed. Nothing in the app reads this yet;
# it is a placeholder for absolute links (share cards, auth redirects) if you add them.
VITE_SITE_URL=http://localhost:5173
